# ================= 模型接入 =================
# 必填。密钥只放在 .env（已在 .gitignore 中排除），不要写进 config.py 或提交到仓库。
API_KEY=
# 兼容旧变量名，二选一即可
API_URL=https://api.deepseek.com
# 模型 endpoint / 模型名，例如火山方舟的 ep-xxxxxxxxxxxx
MODEL_NAME=deepseek-flash

# ================= 运行模式 =================
# true = 使用离线模拟后端（agent/mock.py），不调用真实模型、不消耗额度
# 没有密钥时建议设为 true，可完整跑通 Agent Loop / 工具调用 / 轨迹渲染
MOCK_MODE=true

# ================= Agent 预算控制（可选） =================
# 单次运行的最大步数
AGENT_MAX_STEPS=10
# 单次运行的最大工具调用次数
AGENT_MAX_TOOL_CALLS=14
# 单次运行的最大累计 token
AGENT_MAX_PROMPT_TOKENS=120000
# 单次运行的最大墙钟时间（秒）
AGENT_MAX_WALL_CLOCK_S=300
# 同一工具+相同参数允许重复调用的次数，超出即拦截
AGENT_REPEAT_ACTION_LIMIT=2
# 结构化输出校验失败后的最大重试次数
AGENT_STRUCTURED_RETRY_LIMIT=2
# 采样温度
AGENT_TEMPERATURE=0.1
# 模型不支持原生 function calling 时是否降级为文本 ReAct 协议
AGENT_TEXT_REACT_FALLBACK=true

# ================= 工具开关（可选） =================
AGENT_ENABLE_PYLINT=true
AGENT_ENABLE_BANDIT=true
# 沙箱执行（execute_python_code / run_tests）。有真实执行需求时开启
AGENT_ENABLE_SANDBOX=true
AGENT_SANDBOX_TIMEOUT_S=10
AGENT_SANDBOX_MAX_OUTPUT_CHARS=8000
# 代码库检索工具的检索范围（留空则不注册检索类工具）
AGENT_CODEBASE_ROOT=

# ================= 成本统计（可选） =================
# 填写单价后，轨迹与评测报告会给出成本估算；留空则成本恒为 0
# 单位为「美元 / 1000 tokens」
AGENT_PRICE_PROMPT_PER_1K=0
AGENT_PRICE_COMPLETION_PER_1K=0

# ================= LangGraph 审查助手（review_assistant/，可选） =================
# 这些变量留空时：只要上面的 API_KEY + MODEL_NAME 有值就按 openai provider 走；
# 两者都为空则自动退化为离线 mock 后端（不联网、不花钱，可跑通整张图）。
# LLM_PROVIDER=openai            # openai | deepseek | mock
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_TEMPERATURE=0
# LLM_EXTRA_BODY={}

# 规则库检索用的向量服务；不配置则退化为离线哈希向量（零成本、结果可复现）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
